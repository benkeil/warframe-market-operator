{
  "branches": [
    "main"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "docker buildx imagetools create -t ghcr.io/$GITHUB_REPOSITORY:${nextRelease.version} -t ghcr.io/$GITHUB_REPOSITORY:latest ghcr.io/$GITHUB_REPOSITORY:sha-$GITHUB_SHA && make build-installer IMG=ghcr.io/$GITHUB_REPOSITORY:${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/install.yaml",
            "label": "install.yaml"
          }
        ]
      }
    ]
  ]
}
