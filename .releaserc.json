{
  "branches": [
    "main"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "make docker-build docker-push IMG=ghcr.io/benkeil/warframe-market-operator:${nextRelease.version} && make build-installer IMG=ghcr.io/benkeil/warframe-market-operator:${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/install.yaml",
            "label": "install.yaml"
          }
        ]
      }
    ]
  ]
}
